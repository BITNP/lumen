; Godot 4.6 — Raspberry Girl aggregate output module, presentation process.
; Pure presentation: subtitles (linear reveal), avatar (M2), PPT (M3).
; Connects to the host process presentation bridge, never to the waycast hub.

config_version=5

[application]

config/name="raspberrygirl-presenter-frontend"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
