# waycast hub（必填 URL；token 与核心配置一致，留空则核心须关闭 token 校验）
WAYCAST_HUB_URL=ws://127.0.0.1:8000
WAYCAST_HUB_TOKEN=
# WAYCAST_TLS_CA=/path/to/ca.pem   # wss 自签场景

# TTS 引擎：auto | cosyvoice | audio_cpp（auto = 云主用 + audio.cpp 兜底自动降级，ADR-0001）
LUMEN_TTS_ENGINE=auto

# DashScope CosyVoice（凭据只存本地 .env，不入库）
LUMEN_DASHSCOPE_API_KEY=
LUMEN_COSYVOICE_MODEL=cosyvoice-v3-flash
LUMEN_COSYVOICE_VOICE=<cosyvoice 音色复刻注册后返回的 voice id>

# audio.cpp（外部服务，本机部署于 8080，同时为本机 voice-input 提供 ASR；须自行启动 audiocpp_server）
LUMEN_AUDIO_CPP_URL=http://127.0.0.1:8080
LUMEN_AUDIO_CPP_MODEL=audio8-tts-realistic
LUMEN_AUDIO_CPP_VOICE_REF=/path/to/ref_audio.wav
LUMEN_AUDIO_CPP_REFERENCE_TEXT=<参考音频的逐字转写；留空则 x_vector_only_mode>
# 模型原生采样率：audio8_tts = 44100，Qwen3-TTS = 24000（宿主线性重采样到 16k）
LUMEN_AUDIO_CPP_SAMPLE_RATE=44100
# 云引擎连续失败 N 句后降级、降级后冷却 M 秒回探
LUMEN_TTS_FALLBACK_AFTER=3
LUMEN_TTS_RETRY_AFTER_SECONDS=60

# 句间最少停顿秒数（0 = 不停）：上一句播完到下一句开口至少隔这么久，期间屏上
# 保持上一句字幕；合成等待本身计入间隔（不叠加），首句不等
LUMEN_SENTENCE_GAP_SECONDS=1.0

# 播放设备（留空 = 系统默认输出；名称见 python -m sounddevice）
LUMEN_AUDIO_DEVICE=

# 宿主 ↔ Godot 呈现进程的桥接端口（仅监听 127.0.0.1）
LUMEN_BRIDGE_PORT=8790
# 配置后由宿主负责启动/重启 Godot；留空则需手动运行 godot --path godot/
LUMEN_GODOT_PATH=

# 单元队列上限（溢出即回失败 result）
LUMEN_QUEUE_MAX=64

# deck 根目录（tools/prepare_deck.py 导出到此；留空则 ppt 指令报错不生效）
LUMEN_DECKS_DIR=

# ── 调试日志 ────────────────────────────────────────────────────────
# 本模块日志级别（默认 INFO；DEBUG 输出单元接收、TTS 请求/合成结果、播放完成等）
LUMEN_LOG_LEVEL=INFO
# 第三方依赖日志级别（默认 WARNING：屏蔽 websockets/httpx/asyncio/urllib3）
LUMEN_DEPS_LOG_LEVEL=WARNING
