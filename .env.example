# waycast hub（必填 URL；token 与核心配置一致，留空则核心须关闭 token 校验）
WAYCAST_HUB_URL=ws://127.0.0.1:8000
WAYCAST_HUB_TOKEN=
# WAYCAST_TLS_CA=/path/to/ca.pem   # wss 自签场景

# TTS 引擎：auto | cosyvoice | audio_cpp（audio_cpp 于 M4 落地）
PRESENTER_TTS_ENGINE=auto

# DashScope CosyVoice（凭据只存本地 .env，不入库）
PRESENTER_DASHSCOPE_API_KEY=
PRESENTER_COSYVOICE_MODEL=cosyvoice-v3-flash
PRESENTER_COSYVOICE_VOICE=<cosyvoice 音色复刻注册后返回的 voice id>

# 播放设备（留空 = 系统默认输出；名称见 python -m sounddevice）
PRESENTER_AUDIO_DEVICE=

# 宿主 ↔ Godot 呈现进程的桥接端口（仅监听 127.0.0.1）
PRESENTER_BRIDGE_PORT=8790
# 配置后由宿主负责启动/重启 Godot；留空则需手动运行 godot --path godot/
PRESENTER_GODOT_PATH=

# 单元队列上限（溢出即回失败 result）
PRESENTER_QUEUE_MAX=64

# deck 根目录（tools/prepare_deck.py 导出到此；留空则 ppt 指令报错不生效）
PRESENTER_DECKS_DIR=
